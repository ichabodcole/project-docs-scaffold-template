{
  "name": "{{ cookiecutter.project_slug }}-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation lint for {{ cookiecutter.project_name }}",
  "scripts": {
    "docs:lint": "bun scripts/pdocs/cli.ts check --format text",
    "docs:graph": "bun scripts/pdocs/cli.ts graph --format json",
    "docs:report": "bun scripts/pdocs/cli.ts report --format text",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
