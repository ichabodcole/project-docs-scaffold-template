{
  "name": "project-docs-scaffold-template",
  "version": "8.0.0",
  "description": "Cookiecutter template for scaffolding project documentation structure",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build:dist": "./scripts/build-skills-dist.sh",
    "validate:skills": "uv run scripts/validate-skills-dist.py",
    "format": "prettier --write \"**/*.md\"",
    "format:check": "prettier --check \"**/*.md\"",
    "docs:lint": "bun scripts/pdocs/cli.ts check --format text",
    "docs:graph": "bun scripts/pdocs/cli.ts graph --format json",
    "docs:report": "bun scripts/pdocs/cli.ts report --format text",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "npm run format:check && npm run docs:lint && npm run check:version && npm run check:mirror && npm run check:dist && npm run test",
    "prepare": "husky",
    "prune-branches": "git branch --merged | grep -vE '^[*]|main$|develop$' | xargs -r git branch -d",
    "check:version": "./scripts/check-version.sh",
    "check:mirror": "./scripts/check-mirror.sh",
    "check:dist": "./scripts/check-dist.sh"
  },
  "devDependencies": {
    "@slidev/cli": "^52.14.1",
    "@slidev/theme-default": "^0.25.0",
    "@types/bun": "^1.3.14",
    "agent-cli-conformance": "git+https://github.com/ichabodcole/agent-cli-conformance.git#v0.1.13",
    "husky": "^9.1.7",
    "prettier": "^3.2.5",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "cookiecutter",
    "template",
    "documentation",
    "scaffold"
  ],
  "author": "Cole Reed",
  "license": "MIT",
  "dependencies": {
    "@slidev/theme-seriph": "^0.25.0"
  }
}
